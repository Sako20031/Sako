# Postgres (Neon). On Vercel: Storage → Neon → Connect — the variable is added automatically.
POSTGRES_URL=
# Optional: initial admin PIN before it is changed in the admin panel (default 0000).
ADMIN_PIN=
# Public site address, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=
# Optional: copy every new request to a Telegram chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
