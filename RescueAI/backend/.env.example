# Copy to backend/.env (never commit the real file). All variables use the RESCUE_ prefix.
RESCUE_ENVIRONMENT=development            # development | test | production
RESCUE_DATABASE_URL=sqlite:///./rescue_ai.db
# Production example: postgresql+psycopg://rescue:CHANGE_ME@db.internal:5432/rescue
RESCUE_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
RESCUE_COOKIE_SECURE=false                # must be true in production (HTTPS)
RESCUE_ACCESS_TOKEN_MINUTES=720
RESCUE_STORAGE_DIR=./storage
RESCUE_MAX_UPLOAD_MB=15
RESCUE_RETENTION_DAYS=30

# AI provider. "none" = analysis honestly reported as unavailable.
RESCUE_AI_PROVIDER=none                   # none | anthropic
RESCUE_ANTHROPIC_API_KEY=                 # server-side only; never put it in the frontend
RESCUE_AI_MODEL=claude-opus-5-5
RESCUE_AI_EFFORT=high
RESCUE_AI_TIMEOUT_SECONDS=90
RESCUE_AI_MAX_RETRIES=2
# Set true ONLY after the organisation has authorised sending patient images to the provider
# (data-processing agreement, legal review). Text-only symptom analysis does not need it.
RESCUE_AI_EXTERNAL_IMAGES_AUTHORIZED=false

RESCUE_RATE_LIMIT_ANALYSES_PER_MINUTE=6
RESCUE_RATE_LIMIT_LOGIN_PER_MINUTE=10
